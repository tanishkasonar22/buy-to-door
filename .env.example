# mock = no real ID check (for building and tests). real = Credence ID Cloud SDK.
# mock = no SDK calls. hybrid = real Cloud SDK calls, simulated wallet answer. real = real wallet answers too.
VERIFIER_MODE=mock

# From the Verify with Credence portal (Cloud SDK Key page). Never commit the real values.
CLOUDSDK_LICENSE_KEY=
CLOUDSDK_PROFILE_ID=
# The exact HTTPS origin registered with your license, e.g. https://abc123.example.dev
CLOUDSDK_ORIGIN=
# The SDK Reference and Account Setup pages give this as the base URL. Some older samples use
# https://credenceid.com/cloudsdkdev instead. If /v1/setup returns 404, try that one.
CLOUDSDK_BASE_URL=https://credenceid.com/cloudsdk/playground

# Long random string. Used to sign ticket QR codes.
TICKET_SIGNING_SECRET=change-me-to-a-long-random-string

# Name of the yes/no age field your profile returns. Confirm with DEV_INSPECT on day 1.
AGE_CLAIM_KEY=age_over_21

# 1 = print the NAMES (never values) of fields the verifier returns. Development only.
DEV_INSPECT=0

PORT=3000

# How long a guest claim link stays valid, in hours.
CLAIM_TTL_HOURS=48

# Real mode only. The readiness page makes live Cloud SDK calls, so it needs this token.
# Leave empty to keep the real checks switched off.
READINESS_TOKEN=
